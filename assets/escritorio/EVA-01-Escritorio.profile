[General]
Name=EVA-01-Escritorio
Icon=utilities-terminal
Command=/usr/bin/zsh -i
Environment=TERM=xterm-256color
TerminalMargin=8

[Appearance]
ColorScheme=EVA-01-Escritorio
Font=DejaVu Sans Mono,11,-1,5,400,0,0,0,0,0
AntiAliasFonts=true
BoldIntense=false
TabColor=117,72,163

[Cursor Options]
UseCustomCursorColor=true
CustomCursorColor=197,255,0
CustomCursorTextColor=8,8,11
CursorShape=0

[Interaction Options]
AutoCopySelectedText=true

[Scrolling]
ScrollBarPosition=2
HistorySize=10000
